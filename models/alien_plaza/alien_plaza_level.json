 "cores": 5,
 "events": {
  "market_cleared": {
   "when": "all wave-3 enemies down (waves 1-3 spawn in turn when the player steps into the plaza)",
   "does": [
    "reveal core_1 from the fountain",
    "townsfolk spawn",
    "shops talk"
   ]
  },
  "bells_rung": {
   "when": "bell_1, bell_2, bell_3 hit with the hammer in that order (a wrong bell resets)",
   "does": [
    "mover_bellroom_shutter",
    "reveal core_2"
   ]
  },
  "checkpoint": {
   "when": "player enters trig_checkpoint_* while NOT disguised as a goo guard",
   "does": [
    "guards push the player back"
   ]
  },
  "nest_door": {
   "when": "player enters trig_nest_door while NOT disguised as goo",
   "does": [
    "the two nest guards block and shove the player out"
   ]
  },
  "handle_fitted": {
   "when": "item_sluice_handle carried to sluice_wheel",
   "does": [
    "the wheel can be turned"
   ]
  },
  "sluice_open": {
   "when": "handle_fitted, then sluice_wheel hit 3 times with the hammer",
   "does": [
    "mover_canal_water -2.0 -> -3.4 over 4 s",
    "ledges at -2.9 become walkable"
   ]
  },
  "vault_entered": {
   "when": "trig_vault",
   "does": [
    "grant tech_hover",
    "reveal core_3"
   ]
  },
  "lamp_powered": {
   "when": "gen_1, gen_2, gen_3 destroyed (blaster)",
   "does": [
    "mover_lamp_slab becomes breakable"
   ]
  },
  "lamp_broken": {
   "when": "mover_lamp_slab broken",
   "does": [
    "reveal core_4",
    "lighthouse light on"
   ]
  },
  "fuel_delivered": {
   "when": "fuel_cell carried to npc_00 (launcher)",
   "does": [
    "launch_pad active"
   ]
  },
  "launched": {
   "when": "player uses launch_pad",
   "does": [
    "arc to the keep summit",
    "reveal core_5"
   ]
  },
  "shrine_door": {
   "when": "player reaches trig_shrine_door from INSIDE the shrine",
   "does": [
    "mover_shrine_door opens for good (shortcut)"
   ]
  },
  "beacon": {
   "when": "5 cores held and trig_beacon entered",
   "does": [
    "gate emblem lights",
    "mover_waterfall",
    "mover_vault_door",
    "mover_lift live",
    "boulders start rolling",
    "portal_exit on"
   ]
  }
 },
